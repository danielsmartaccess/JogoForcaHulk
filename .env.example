# Usado SOMENTE pelos testes (supabase/tests/*.mjs) e scripts locais.
# O site é estático e NÃO lê este arquivo: a URL e a chave publishable ficam em config.js
# (valores públicos por desenho; a proteção real são as políticas RLS no banco).
#
# Copie para .env e preencha. O .env está no .gitignore.

# Ambiente local (npx supabase start) ou o URL do seu projeto: https://<ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# Chave PUBLISHABLE (sb_publishable_...). Veja `npx supabase status` ou Project Settings > API Keys.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Caixa de e-mail de teste do Supabase local (confirmação de cadastro).
MAIL_URL=http://127.0.0.1:54324

# NUNCA coloque no frontend nem neste arquivo versionado:
#   secret key / service_role, senha do banco, SUPABASE_ACCESS_TOKEN.
